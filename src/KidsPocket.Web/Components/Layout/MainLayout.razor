@inherits LayoutComponentBase
@implements IDisposable
@using KidsPocket.Web.Services
@inject ClientAuthState AuthState
@inject NavigationManager Nav

<div class="app-shell">
    <header class="app-header">
        <span class="app-logo">🐷</span>
        <span class="app-title">KidsPocket</span>
        @if (AuthState.IsAuthenticated)
        {
            <div class="app-user">
                <span>@(AuthState.IsParent ? "👨‍👩‍👧" : "🧒") @AuthState.DisplayName</span>
                <button class="btn-link" @onclick="Logout">🚪 יציאה</button>
            </div>
        }
    </header>
    <main class="app-main">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        AuthState.Changed += OnAuthChanged;
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    private void Logout()
    {
        AuthState.Clear();
        Nav.NavigateTo("/login", forceLoad: false);
    }

    public void Dispose()
    {
        AuthState.Changed -= OnAuthChanged;
    }
}
