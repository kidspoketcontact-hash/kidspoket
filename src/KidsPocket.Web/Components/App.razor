<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KidsPocket</title>
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <script src="https://appleid.cdn-apple.com/appleauth/static/jsapi/appleid/1/en_US/appleid.auth.js" async></script>
    <HeadOutlet />
</head>
<body>
    <!-- prerender:false בכוונה - כל דף כאן תלוי ב-ClientAuthState (Scoped per-circuit). פרנדור
         סטטי רץ ב-DI scope חד-פעמי נפרד מה-circuit, כך שהוא תמיד "לא מחובר" ומפיל את כל
         בדיקות ה-Auth בדפים למסך login, עוד לפני שה-circuit האינטראקטיבי האמיתי מתחבר. -->
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
    <script src="_framework/blazor.web.js"></script>
    <script src="js/auth.js"></script>
</body>
</html>
